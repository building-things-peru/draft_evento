rules_version = '2';

// Reglas para el recorrido del Loft del Evento.
// Cualquiera con el link puede leer y dejar notas (no hay login),
// pero solo se aceptan documentos con la forma que usa la página.

service cloud.firestore {
  match /databases/{database}/documents {

    function validText(d) {
      return d.text is string && d.text.size() > 0 && d.text.size() <= 600;
    }

    match /pins/{id} {
      allow read: if true;
      allow create: if validText(request.resource.data)
        && request.resource.data.type in ['rec', 'task', 'idea', 'warn']
        && request.resource.data.x is number
        && request.resource.data.y is number
        && request.resource.data.z is number;
      // Solo se puede cambiar el estado "hecho".
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is bool;
      allow delete: if true;
    }

    match /replies/{id} {
      allow read: if true;
      allow create: if validText(request.resource.data) && request.resource.data.pin is string;
      allow delete: if true;
    }

    // Posición en vivo de quienes están recorriendo el local.
    match /presence/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.x is number
        && request.resource.data.z is number
        && request.resource.data.t is number
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
    }
  }
}
